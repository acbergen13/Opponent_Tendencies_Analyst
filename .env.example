# Copy to .env and fill in real values. Never commit .env.

# VT ARC OpenAI-compatible LLM endpoint (required).
VT_ARC_BASE_URL=https://llm-api.arc.vt.edu/api/v1
VT_ARC_API_KEY=
VT_ARC_MODEL=

# Optional: provider-side reasoning for chat calls. The pinned vt-arc-llm model
# reasons by default, which can consume the whole completion cap before any JSON
# is emitted. Leave this false for report runs; set it to true only to opt in.
VT_ARC_ENABLE_THINKING=false

# Embedding model pinned for the media index. The resolved ID is recorded in
# the Chroma index metadata so a model change forces a rebuild.
EMBEDDING_MODEL=

# Local storage for the play/media stores and the Chroma index (gitignored).
DATA_DIR=data
CHROMA_DIR=data/chroma
